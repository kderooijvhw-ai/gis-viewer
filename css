html,
body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: Segoe UI, Arial, sans-serif;
}

#sidebar {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 320px;
    background: #fff;
    padding: 15px;
    overflow: auto;
    z-index: 1000;
    box-shadow: 2px 0 10px rgba(0,0,0,.2);
}

#map {
    position: absolute;
    left: 320px;
    right: 0;
    top: 0;
    bottom: 0;
}

button {
    width: 100%;
    padding: 10px;
    margin-top: 10px;
    border: none;
    background: #0078d4;
    color: white;
    cursor: pointer;
    border-radius: 4px;
}

button:hover {
    background: #106ebe;
}

#dropzone {
    border: 2px dashed #999;
    padding: 15px;
    text-align: center;
    margin-top: 10px;
    background: #fafafa;
    border-radius: 5px;
}

#coords,
#featureInfo {
    padding: 10px;
    background: #f5f5f5;
    margin-top: 5px;
    border-radius: 4px;
    font-size: 14px;
}

.layer-item {
    margin-bottom: 5px;
}
