html,
body{
margin:0;
height:100%;
font-family:Segoe UI,Arial,sans-serif;
}

#sidebar{
position:absolute;
left:0;
top:0;
bottom:0;
width:320px;
background:white;
padding:15px;
overflow:auto;
z-index:1000;
box-shadow:2px 0 8px rgba(0,0,0,0.2);
}

#map{
position:absolute;
left:320px;
right:0;
top:0;
bottom:0;
}

button{
width:100%;
padding:10px;
margin-top:10px;
background:#0078D4;
border:none;
color:white;
cursor:pointer;
border-radius:4px;
}

button:hover{
background:#005fa3;
}

#dropzone{
margin-top:10px;
padding:20px;
border:2px dashed #999;
border-radius:6px;
text-align:center;
background:#fafafa;
}

h2{
margin-top:0;
}

h3{
margin-bottom:5px;
}
