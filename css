.layer-group{
    font-family: Arial, sans-serif;
    font-size:14px;
}

.layer-group h3{
    margin-top:15px;
    margin-bottom:8px;
    color:#003366;
}

.layer-group label{
    display:block;
    margin-bottom:6px;
}

.tool-btn{
    width:100%;
    padding:8px;
    margin-bottom:5px;
    cursor:pointer;
    border:none;
    border-radius:4px;
    background:#005baa;
    color:white;
}

.tool-btn:hover{
    background:#004080;
}
